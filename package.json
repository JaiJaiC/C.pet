{
  "name": "c-pet",
  "version": "1.12.7",
  "author": "C.pet",
  "description": "A QQ-pet-like desktop pet with editable todo notes.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.local.cpet",
    "productName": "C.pet",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "note.html",
      "styles.css",
      "app.js",
      "note.js",
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/task_icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "C.pet.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
